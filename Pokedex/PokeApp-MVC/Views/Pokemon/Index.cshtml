@model IEnumerable<dominio.Pokemon>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<hr />

<div>
    <form asp-action="Index" method="get">
        <input type="text" name="filtro" class="form-control" value="@ViewBag.filtro" placeholder="Buscar por nombre"/>
        <button type="submit" class="btn btn-outline-success">Buscar</button>
    </form>
</div>

<hr />

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Numero)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
@*             <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.UrlImagen)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Debilidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Numero)
            </td>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Descripcion)
            </td> *@
            <td>
                @* @Html.DisplayFor(model => item.UrlImagen) *@
                <img src="@item.UrlImagen" height="70" alt="Imagen de Pokemon" />
            </td>
            <td>
                @Html.DisplayFor(model => item.Tipo.Descripcion)
            </td> 
            <td>
                @Html.DisplayFor(model => item.Debilidad.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                <a asp-action="Edit" asp-route-Id="@item.Id">Edit</a> |
                @* <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | *@
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
